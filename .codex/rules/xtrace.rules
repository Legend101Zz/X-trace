# Commands that AGENTS.md forbids. Codex applies the most restrictive matching rule.
prefix_rule(pattern = ["pkill"], decision = "forbidden", justification = "AGENTS.md: never kill by pattern")
prefix_rule(pattern = ["killall"], decision = "forbidden", justification = "AGENTS.md: never kill by pattern")
prefix_rule(pattern = ["sudo"], decision = "forbidden", justification = "AGENTS.md: no sudo")
prefix_rule(pattern = ["diskutil"], decision = "forbidden", justification = "AGENTS.md: no disk tools")
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "AGENTS.md: never force-push")
prefix_rule(pattern = ["git", "push", "origin", "main"], decision = "forbidden", justification = "AGENTS.md: main changes only through pull requests")
