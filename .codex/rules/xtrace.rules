# Commands that AGENTS.md forbids. Codex applies the most restrictive matching rule.
prefix_rule(pattern = ["pkill"], decision = "forbidden", justification = "AGENTS.md: never kill by pattern")
prefix_rule(pattern = ["killall"], decision = "forbidden", justification = "AGENTS.md: never kill by pattern")
prefix_rule(pattern = ["sudo"], decision = "forbidden", justification = "AGENTS.md: no sudo")
prefix_rule(pattern = ["diskutil"], decision = "forbidden", justification = "AGENTS.md: no disk tools")
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "AGENTS.md: never force-push")
prefix_rule(pattern = ["git", "push", "origin", "main"], decision = "forbidden", justification = "AGENTS.md: main changes only through pull requests")
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden", justification = "AGENTS.md: never force-push")
prefix_rule(pattern = ["git", "push", "--force-with-lease"], decision = "forbidden", justification = "AGENTS.md: never force-push")
prefix_rule(pattern = ["git", "push", "-u", "origin", "main"], decision = "forbidden", justification = "AGENTS.md: main changes only through pull requests")
prefix_rule(pattern = ["git", "push", "--set-upstream", "origin", "main"], decision = "forbidden", justification = "AGENTS.md: main changes only through pull requests")
prefix_rule(pattern = ["docker", "system", "prune"], decision = "forbidden", justification = "AGENTS.md: no docker prune")
prefix_rule(pattern = ["docker", "image", "prune"], decision = "forbidden", justification = "AGENTS.md: no docker prune")
prefix_rule(pattern = ["docker", "container", "prune"], decision = "forbidden", justification = "AGENTS.md: no docker prune")
prefix_rule(pattern = ["docker", "volume", "prune"], decision = "forbidden", justification = "AGENTS.md: no docker prune")
prefix_rule(pattern = ["docker", "builder", "prune"], decision = "forbidden", justification = "AGENTS.md: no docker prune")
