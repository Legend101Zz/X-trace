{
 "version": 1,
 "description": "Shared route-normalizer vectors (PLAN A2, RT-8). Consumed by the Rust domain tests, the Java static analyzer and the Node static analyzer. input is a string, or an array of path parts that are joined before normalizing. Frameworks: spring-mvc, jaxrs, express, fastify, nest, generic. Never edit a case to make an implementation pass.",
 "cases": [
  {
   "name": "root_empty",
   "framework": "generic",
   "input": "",
   "identity": "/",
   "display": "/",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "root_slashes",
   "framework": "generic",
   "input": "///",
   "identity": "/",
   "display": "/",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "plain_literal",
   "framework": "generic",
   "input": "/orders",
   "identity": "/orders",
   "display": "/orders",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "missing_leading_slash",
   "framework": "generic",
   "input": "orders/list",
   "identity": "/orders/list",
   "display": "/orders/list",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "repeated_separators",
   "framework": "generic",
   "input": "//a///b",
   "identity": "/a/b",
   "display": "/a/b",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "trailing_slash",
   "framework": "generic",
   "input": "/a/b/",
   "identity": "/a/b",
   "display": "/a/b",
   "strictSlash": true,
   "wildcard": false,
   "params": []
  },
  {
   "name": "colon_param",
   "framework": "express",
   "input": "/users/:id",
   "identity": "/users/{id}",
   "display": "/users/{id}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "id"
   ]
  },
  {
   "name": "colon_param_renamed",
   "framework": "express",
   "input": "/users/:userId",
   "identity": "/users/{id}",
   "display": "/users/{userId}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "userId"
   ]
  },
  {
   "name": "colon_param_regex",
   "framework": "express",
   "input": "/users/:id(\\d+)",
   "identity": "/users/{id}",
   "display": "/users/{id}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "id"
   ]
  },
  {
   "name": "colon_optional",
   "framework": "express",
   "input": "/users/:id?",
   "identity": "/users/{id}",
   "display": "/users/{id}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "id"
   ]
  },
  {
   "name": "colon_mixed_segment",
   "framework": "fastify",
   "input": "/:file.:ext",
   "identity": "/{id}.{id}",
   "display": "/{file}.{ext}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "file",
    "ext"
   ]
  },
  {
   "name": "colon_two_params",
   "framework": "express",
   "input": "/flights/:from-:to",
   "identity": "/flights/{id}-{id}",
   "display": "/flights/{from}-{to}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "from",
    "to"
   ]
  },
  {
   "name": "brace_param",
   "framework": "spring-mvc",
   "input": "/owners/{ownerId}",
   "identity": "/owners/{id}",
   "display": "/owners/{ownerId}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "ownerId"
   ]
  },
  {
   "name": "brace_regex",
   "framework": "spring-mvc",
   "input": "/users/{id:[0-9]+}",
