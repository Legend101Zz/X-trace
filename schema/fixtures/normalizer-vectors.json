   "display": "/users/{id}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "id"
   ]
  },
  {
   "name": "angle_converter",
   "framework": "generic",
   "input": "/users/<int:id>",
   "identity": "/users/{id}",
   "display": "/users/{id}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "id"
   ]
  },
  {
   "name": "spring_catch_all",
   "framework": "spring-mvc",
   "input": "/static/{*rest}",
   "identity": "/static/{*}",
   "display": "/static/{*rest}",
   "strictSlash": false,
   "wildcard": true,
   "params": [
    "rest"
   ]
  },
  {
   "name": "star_segment",
   "framework": "fastify",
   "input": "/files/*",
   "identity": "/files/*",
   "display": "/files/*",
   "strictSlash": false,
   "wildcard": true,
   "params": []
  },
  {
   "name": "named_splat",
   "framework": "express",
   "input": "/files/*splat",
   "identity": "/files/{*}",
   "display": "/files/{*splat}",
   "strictSlash": false,
   "wildcard": true,
   "params": [
    "splat"
   ]
  },
  {
   "name": "encoded_slash_preserved",
   "framework": "generic",
   "input": "/a%2fb",
   "identity": "/a%2Fb",
   "display": "/a%2Fb",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "unreserved_escape_decoded",
   "framework": "generic",
   "input": "/a%41%7e",
   "identity": "/aA~",
   "display": "/aA~",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "backslash_escapes_colon",
   "framework": "express",
   "input": "/a\\:b",
   "identity": "/a%3Ab",
   "display": "/a%3Ab",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "literal_colon_in_spring",
   "framework": "spring-mvc",
   "input": "/a:b",
   "identity": "/a%3Ab",
   "display": "/a%3Ab",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "joined_class_and_method",
   "framework": "spring-mvc",
   "input": [
    "/owners/{ownerId}",
    "pets/{petId}/"
   ],
   "identity": "/owners/{id}/pets/{id}",
   "display": "/owners/{ownerId}/pets/{petId}",
   "strictSlash": true,
   "wildcard": false,
   "params": [
    "ownerId",
    "petId"
   ]
  },
  {
   "name": "joined_empty_parts",
   "framework": "spring-mvc",
   "input": [
    "",
    "/api",
    ""
   ],
   "identity": "/api",
   "display": "/api",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "joined_express_mount",
   "framework": "express",
   "input": [
    "/api/v1",
    "/users/:id"
   ],
   "identity": "/api/v1/users/{id}",
   "display": "/api/v1/users/{id}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "id"
   ]
  },
  {
   "name": "unicode_literal",
   "framework": "generic",
   "input": "/café",
   "identity": "/café",
   "display": "/café",
   "strictSlash": false,
   "wildcard": false,
   "params": []
  },
  {
   "name": "query_rejected",
   "framework": "generic",
   "input": "/a?x=1",
   "error": "query_or_fragment"
  },
  {
   "name": "fragment_rejected",
   "framework": "generic",
   "input": "/a#f",
   "error": "query_or_fragment"
  },
  {
   "name": "unclosed_brace",
   "framework": "spring-mvc",
   "input": "/a/{id",
   "error": "unbalanced_parameter"
  },
  {
   "name": "stray_close_brace",
   "framework": "spring-mvc",
   "input": "/a/id}",
   "error": "unbalanced_parameter"
  },
  {
   "name": "empty_param_name",
   "framework": "spring-mvc",
   "input": "/a/{}",
   "error": "invalid_parameter_name"
  },
  {
   "name": "bad_param_name",
   "framework": "spring-mvc",
   "input": "/a/{bad name}",
   "error": "invalid_parameter_name"
  },
  {
   "name": "malformed_escape",
   "framework": "generic",
   "input": "/a/%zz",
   "error": "invalid_escape"
  },
  {
   "name": "control_character",
