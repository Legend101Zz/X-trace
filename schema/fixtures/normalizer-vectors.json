   "display": "/users/{id}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "id"
   ]
  },
  {
   "name": "jaxrs_regex_with_space",
   "framework": "jaxrs",
   "input": "/users/{ id : [0-9]{1,3} }",
   "identity": "/users/{id}",
   "display": "/users/{id}",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "id"
   ]
  },
  {
   "name": "jaxrs_regex_with_slash",
   "framework": "jaxrs",
   "input": "/files/{path: .+/[a-z]{2}}/raw",
   "identity": "/files/{id}/raw",
   "display": "/files/{path}/raw",
   "strictSlash": false,
   "wildcard": false,
   "params": [
    "path"
   ]
  },
  {
   "name": "angle_param",
   "framework": "generic",
   "input": "/users/<id>",
