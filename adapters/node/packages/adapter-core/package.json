{
  "name": "@xtrace/adapter-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./register.cjs": "./dist/register.cjs",
    "./register.mjs": "./dist/register.mjs",
    "./manifest": "./dist/node-capabilities.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-runtime-assets.mjs",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@xtrace/protocol": "0.1.0",
    "@bufbuild/protobuf": "2.16.0",
    "hash-wasm": "4.12.0",
    "uuid": "14.0.2"
  }
}
